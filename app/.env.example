# Skopiuj do .env POZA public_html (np. /domains/finanse.bezprzemocowo.pl/.env)
# i uzupełnij. Sekrety NIGDY nie trafiają do repo (DECYZJE #62).

# --- baza (panel seohost -> MySQL) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- sesje ---
# wygeneruj: openssl rand -hex 32
JWT_SECRET=

# --- Google OAuth (console.cloud.google.com -> Credentials -> OAuth client ID, typ: Web) ---
# Authorized redirect URI: https://finanse.bezprzemocowo.pl/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- adres aplikacji ---
BASE_URL=https://finanse.bezprzemocowo.pl

# --- token read-only dla widgetu dashboardu (GET /api/v1/summary, nagłówek X-Widget-Token) ---
# wygeneruj: openssl rand -hex 24
WIDGET_TOKEN=

# --- e-maile Google członków rodziny (używane przy migracji i logowaniu) ---
EMAIL_SZYMON=
EMAIL_ANNA=
EMAIL_BARTEK=
EMAIL_PERSEVERA=

# --- OCR paragonów ---
# folder na obrobione zdjęcia (poza docrootem); domyślnie ../receipts względem app
RECEIPTS_DIR=
# hybryda: przycisk "Popraw AI" (opcjonalny; bez klucza przycisk się nie pokazuje)
ANTHROPIC_API_KEY=
AI_OCR_MODEL=claude-haiku-4-5-20251001

# --- warstwa modelu do ANALIZ okresowych (Z12; opcjonalne) ---
# 'brak' (domyślnie) = analizy liczą się z danych, bez narracji AI.
# 'anthropic' = dołóż omówienie tekstowe (wymaga ANTHROPIC_API_KEY wyżej i włączenia
#   modalności 'model_zewnetrzny' w panelu Admin → Dostęp). W przyszłości: model lokalny family-os.
MODEL_DOSTAWCA=brak
# model do narracji analiz (gdy MODEL_DOSTAWCA=anthropic); domyślnie claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
